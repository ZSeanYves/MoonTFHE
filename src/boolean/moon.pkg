import {
  "moonbitlang/core/bench",
  "ZSeanYves/MoonTFHE/src/params",
  "ZSeanYves/MoonTFHE/src/torus",
  "ZSeanYves/MoonTFHE/src/random",
  "ZSeanYves/MoonTFHE/src/core/lwe",
  "ZSeanYves/MoonTFHE/src/core/glwe",
  "ZSeanYves/MoonTFHE/src/core/keyswitch",
  "ZSeanYves/MoonTFHE/src/core/ggsw",
  "ZSeanYves/MoonTFHE/src/core/pbs",
  "ZSeanYves/MoonTFHE/src/native/provider",
  "moonbitlang/core/bytes",
  "moonbitlang/core/ref",
}

options(
  link: {
    "native": {
      "cc-link-flags": "native/fft/target/release/libmoontfhe_fft.a native/aead/target/release/libmoontfhe_aead.a -lm",
    },
  },
  targets: {
    "backend_native.mbt": [ "native" ],
    "backend_js.mbt": [ "js" ],
    "backend_wasm.mbt": [ "wasm" ],
    "backend_wasm_gc.mbt": [ "wasm-gc" ],
    "api_native_test.mbt": [ "native" ],
    "api_portable_test.mbt": [ "wasm", "wasm-gc", "js" ],
    "aead_portable_wbtest.mbt": [ "wasm", "wasm-gc", "js" ],
    "portable_standard_smoke_test.mbt": [ "wasm", "wasm-gc", "js" ],
    "fourier_import_native.mbt": [ "native" ],
    "fourier_import_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "standard_keygen_native.mbt": [ "native" ],
    "standard_keygen_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "standard_benchmark.mbt": [ "native" ],
    "standard_stress_native_test.mbt": [ "native" ],
    "serialization_mutation_native_test.mbt": [ "native" ],
    "benchmark_driver_native_wbtest.mbt": [ "native" ],
  },
)
